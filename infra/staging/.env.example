# DNS A/AAAA record must point this hostname to the staging server.
API_DOMAIN=api.example.com

# Use URL-safe random values. Example generators:
#   openssl rand -hex 24
#   openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-48-hex-characters
AUTH_TOKEN_SECRET=replace-with-64-hex-characters

# Optional. Without this key the deterministic local AI provider is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
